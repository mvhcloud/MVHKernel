{
  "name": "MVH Kernel",
  "version": "1.1.10",
  "website": "https://kernel.mvhcloud.com/",
  "architecture": "x86_64",
  "format": "ELF64",
  "entry": "_multiboot_start",
  "requires": [
    "x86_64-long-mode",
    "identity-mapped-first-gib",
    "bootinfo-v2-or-legacy-memory-size-kib",
    "multiboot-v1-direct-qemu"
  ],
  "license": "MIT",
  "release_log": "CHANGELOG.md",
  "default_language": "en",
  "languages": ["en", "de", "es", "fr"],
  "keyboard_layout": "en-US",
  "drivers": [
    "vga-text-cursor",
    "linear-framebuffer-24-32bpp",
    "serial-uart-16550",
    "serial-uart-input-console",
    "keyboard-input-event-layer",
    "ps2-keyboard-en-us",
    "x86-cpuid",
    "x86-fpu-xsave",
    "x86-msr-rng",
    "intel-dts-temperature",
    "amd-northbridge-smn-temperature",
    "x86-paging",
    "cmos-rtc",
    "pci-config-bars",
    "x86-idt-pic",
    "x86-local-apic-ioapic",
    "x86-init-sipi-sipi-application-processor-startup",
    "x86-per-cpu-gs-local-storage",
    "x86-per-cpu-gdt-tss-ist",
    "x86-exception-dispatch",
    "bootinfo-v2-handoff",
    "acpi-rsdp-xsdt-rsdt",
    "smbios-2-and-3-platform-metadata",
    "pit-8254",
    "hpet-monotonic-counter",
    "ata-pio-lba28-disk",
    "virtio-block-transitional-queue",
    "ramfs",
    "vfs-root",
    "device-manager"
  ],
  "kernel_layers": [
    "hal",
    "physical-page-allocator",
    "kernel-heap",
    "vfs",
    "task-registry",
    "kernel-log",
    "kernel-panic",
    "atomics-spinlocks-mutexes",
    "kernel-self-test",
    "cpu-hardware-diagnostics",
    "interrupt-statistics",
    "heap-hardening",
    "panic-error-decoder",
    "panic-stack-trace",
    "kernel-assertions",
    "entropy-pool-chacha20",
    "ticket-and-rw-locks",
    "block-device-registry",
    "polling-ata-persistent-block-io",
    "virtio-block-persistent-io",
    "smp-application-processor-runtime",
    "per-cpu-kernel-stacks-and-idle-loops",
    "reschedule-stop-and-tlb-shootdown-ipi",
    "cooperative-kernel-thread-context-switch",
    "priority-round-robin-ready-sleep-block-zombie-states",
    "thread-affinity-and-scheduler-statistics",
    "smp-serialized-pmm-and-kernel-heap",
    "atomic64-semaphore-completion-condition-seqlock",
    "dma32-dma64-coherent-and-scatter-gather-framework",
    "ethernet-arp-ipv4-icmp-udp-protocol-core",
    "expiring-arp-cache-and-longest-prefix-routing",
    "graphical-setup-and-desktop-runtime",
    "mbr-gpt-partition-probe",
    "crc32-integrity-core",
    "validated-gpt-header-and-entry-array",
    "calloc-and-realloc-heap-api",
    "validated-bootinfo-v2",
    "firmware-memory-framebuffer-and-random-seed-handoff",
    "central-kernel-feature-config",
    "versioned-kernel-and-boot-abi",
    "validated-acpi-table-registry",
    "madt-fadt-hpet-mcfg-srat-slit-metadata",
    "firmware-cpu-ioapic-and-irq-routing-registry",
    "runtime-ioapic-pit-routing-with-pic-fallback",
    "pcie-mcfg-segment-registry",
    "pcie-ecam-remapped-mmio-window",
    "firmware-memory-and-security-diagnostics",
    "one-hundred-fifty-bounded-kernel-utility-apis",
    "compiler-stack-protector-strong",
    "native-utility-api-coverage",
    "mvhfs-copy-on-write-persistent-filesystem",
    "mvhfs-dual-superblock-recovery",
    "mvhfs-file-and-metadata-crc32",
    "qemu-cold-reboot-persistence-validation"
  ],
  "memory": {
    "page_size": 4096,
    "identity_map_limit_mib": 4096,
    "heap_size_mib": 1,
    "nx_capability_detection": true,
    "nx_enforcement": true,
    "null_page_unmapped": true,
    "supervisor_write_protect": true,
    "dynamic_page_mapping": true,
    "user_kernel_separation": false
  },
  "limitations": [
    "kernel-mode-only",
    "volatile-root-filesystem",
    "no-userspace-elf-loader",
    "physical-memory-management-limited-to-four-gib-on-multiboot-path",
    "cooperative-kernel-thread-scheduler-is-bsp-owned-and-not-yet-timer-preemptive-or-smp-load-balanced",
    "cpu-temperature-limited-to-supported-intel-dts-and-amd-families",
    "no-supported-network-device-driver",
    "no-ahci-nvme-or-usb-driver",
    "random-output-not-ready-below-256-estimated-entropy-bits"
  ],
  "compatibility": {
    "abi": 2,
    "boot_abi": 2,
    "release_series": "1.1",
    "backward_compatible_with": ["1.1", "1.1.1", "1.1.2", "1.1.3", "1.1.4", "1.1.5", "1.1.6", "1.1.6-2", "1.1.7", "1.1.8", "1.1.8/2"]
  }
}
